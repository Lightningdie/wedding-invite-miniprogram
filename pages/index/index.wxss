/* 内嵌英文书法字体（Great Vibes）：base64 离线可用 */
@font-face {
  font-family: 'GreatVibes';
  src: url(data:font/woff;base64,) format('woff');
  font-weight: 400;
  font-style: normal;
}

/* 欧式复古请柬 · 单页竖向连续滑动 · 隐藏滚动条 */

::-webkit-scrollbar {
  width: 0 !important;
  height: 0 !important;
  display: none !important;
  background: transparent !important;
}

.hide-scrollbar,
.photo-masonry,
.story-list {
  scrollbar-width: none;
}

.invite {
  width: 100%;
  min-height: 100vh;
  /* 整页一整条连续渐变 + 多层柔光：白偏黄基调，既有层次又无接缝色差 */
  background:
    radial-gradient(circle at 20% 8%, rgba(255, 253, 248, 0.55), transparent 36%),
    radial-gradient(circle at 82% 46%, rgba(214, 190, 150, 0.12), transparent 42%),
    radial-gradient(circle at 26% 82%, rgba(255, 253, 248, 0.4), transparent 40%),
    linear-gradient(176deg, #FBF7EE 0%, #F9F3E6 16%, #F7F0E1 55%, #F4EBDA 100%);
  position: relative;
}

/* ========== 区块通用 ========== */
.sec {
  width: 100%;
  box-sizing: border-box;
  padding: 128rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  position: relative;
}

/* 区块衔接：顶部细金线 + 居中小纹样，把各区块串成一整页 */
.sec:not(.hero-sheet)::before {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 320rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(196, 160, 106, 0.7), transparent);
  z-index: 1;
}

.sec:not(.hero-sheet)::after {
  content: '✦';
  position: absolute;
  top: 5rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  color: rgba(196, 160, 106, 0.9);
  line-height: 1;
  z-index: 2;
}

.parchment {
  /* 透明，承接整页连续渐变，保证区块衔接零色差 */
  background: transparent;
}

/* 入场动画：滚入视口时由 .reveal 触发 */
.enter { opacity: 0; }

.reveal .enter-left {
  animation: slideInLeft 1.3s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}
.reveal .enter-right {
  animation: slideInRight 1.3s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}
.reveal .enter-up {
  animation: slideInUp 1.3s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}
.reveal .enter-down {
  animation: slideInDown 1.3s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}

.d1 { animation-delay: 0.05s !important; }
.d2 { animation-delay: 0.18s !important; }
.d3 { animation-delay: 0.31s !important; }
.d4 { animation-delay: 0.44s !important; }
.d5 { animation-delay: 0.57s !important; }
.d6 { animation-delay: 0.70s !important; }
.d7 { animation-delay: 0.83s !important; }
.d8 { animation-delay: 0.96s !important; }
.d9 { animation-delay: 1.09s !important; }
.d10 { animation-delay: 1.22s !important; }

@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-80rpx); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes slideInRight {
  from { opacity: 0; transform: translateX(80rpx); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes slideInUp {
  from { opacity: 0; transform: translateY(70rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes slideInDown {
  from { opacity: 0; transform: translateY(-70rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 装饰 */
.latin-tag {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 22rpx;
  letter-spacing: 10rpx;
  text-transform: uppercase;
  color: #A67C52;
  align-self: center;
  margin-bottom: 14rpx;
  font-style: italic;
}

.section-title {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 56rpx;
  color: #5C4030;
  letter-spacing: 8rpx;
  font-weight: 400;
  margin-bottom: 8rpx;
  align-self: center;
  text-align: center;
}

.ornament {
  font-size: 40rpx;
  color: #C4A06A;
  margin: 16rpx 0 48rpx;
  align-self: center;
  opacity: 0.9;
  text-shadow: 0 0 18rpx rgba(196, 160, 106, 0.3);
}

.corner {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-color: #C4A06A;
  opacity: 0.5;
  z-index: 2;
}
.corner-tl { top: 36rpx; left: 36rpx; border-top: 2rpx solid; border-left: 2rpx solid; }
.corner-tr { top: 36rpx; right: 36rpx; border-top: 2rpx solid; border-right: 2rpx solid; }
.corner-bl { bottom: 36rpx; left: 36rpx; border-bottom: 2rpx solid; border-left: 2rpx solid; }
.corner-br { bottom: 36rpx; right: 36rpx; border-bottom: 2rpx solid; border-right: 2rpx solid; }

/* 控件 */
.music-btn {
  position: fixed;
  top: 36rpx;
  right: 28rpx;
  z-index: 110;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 254, 250, 0.86);
  border: 1rpx solid rgba(170, 140, 100, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(70, 45, 20, 0.1);
}

.music-icon {
  width: 38rpx;
  height: 38rpx;
}

/* 关闭状态：音符上加一道斜线 */
.music-slash {
  position: absolute;
  width: 54rpx;
  height: 2rpx;
  background: #8A7355;
  border-radius: 2rpx;
  transform: rotate(-45deg);
}

/* 播放中：柔和金色脉冲光环 */
.music-on {
  animation: musicPulse 2.2s ease-out infinite;
}

@keyframes musicPulse {
  0% { box-shadow: 0 0 0 0 rgba(196, 160, 106, 0.4); }
  70% { box-shadow: 0 0 0 16rpx rgba(196, 160, 106, 0); }
  100% { box-shadow: 0 0 0 0 rgba(196, 160, 106, 0); }
}

/* ========== 封面 ========== */
.hero-sheet {
  padding: 0;
  height: 100vh;
  align-items: center;
  overflow: hidden;
  background: #FAF5EB;
}

.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* 顶部轻微压暗，保证白色花体字可读 */
.hero-topshade {
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(
    180deg,
    rgba(58, 44, 28, 0.24) 0%,
    rgba(58, 44, 28, 0.08) 26%,
    rgba(58, 44, 28, 0) 44%
  );
}

/* 底部掉色晕染：照片渐渐融入页面底色（终点色与整页渐变在此处的颜色一致，无接缝） */
.hero-bottomfade {
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(
    180deg,
    rgba(250, 245, 235, 0) 44%,
    rgba(250, 245, 235, 0.5) 66%,
    rgba(250, 245, 235, 0.9) 85%,
    #FAF5EB 100%
  );
}

.hero-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 30rpx;
  padding-top: 24vh;
  text-align: center;
}

/* 花体字 We got married（白色） */
.hero-script {
  font-family: 'GreatVibes', 'Snell Roundhand', 'Brush Script MT', cursive;
  font-size: 104rpx;
  line-height: 1.35;
  color: #FFFFFF;
  letter-spacing: 0;
  text-shadow: 0 2rpx 22rpx rgba(70, 50, 30, 0.42), 0 0 2rpx rgba(70, 50, 30, 0.3);
}

/* 姓名与日期：叠在底部晕染之上，黑色字 */
.hero-landing {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 132rpx;
  z-index: 3;
  text-align: center;
  padding: 0 40rpx;
}

.hero-names {
  font-family: Georgia, 'Songti SC', 'PingFang SC', serif;
  font-size: 56rpx;
  font-weight: 400;
  color: #241E17;
  letter-spacing: 6rpx;
  line-height: 1.3;
}

.hero-amp {
  font-family: Georgia, serif;
  font-style: italic;
  font-size: 42rpx;
  color: #7A654E;
}

.hero-date {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #3A322A;
  letter-spacing: 4rpx;
}

.scroll-hint {
  position: absolute;
  bottom: 52rpx;
  left: 0;
  right: 0;
  z-index: 3;
  text-align: center;
  color: rgba(90, 74, 55, 0.7);
  font-size: 20rpx;
  letter-spacing: 4rpx;
  font-family: Georgia, serif;
  animation: floatHint 2.4s ease-in-out infinite;
}

@keyframes floatHint {
  0%, 100% { transform: translateY(0); opacity: 0.55; }
  50% { transform: translateY(10rpx); opacity: 0.9; }
}

/* ========== 邀请（第二页） ========== */
.invitation-sheet {
  align-items: stretch;
}

/* 顶部是花体标题，去掉区块衔接的金线与小纹样 */
.invitation-sheet::before,
.invitation-sheet::after {
  content: none;
}

/* 第一行：英文花体标题（艺术字，居中） */
.invite-headline {
  margin: 0 0 36rpx;
  align-self: center;
  text-align: center;
  font-family: 'GreatVibes', 'Snell Roundhand', 'Brush Script MT', cursive;
  font-size: 68rpx;
  line-height: 1.4;
  color: #4A3A2C;
  letter-spacing: 0;
}

/* 第二行：整幅出血照片，底部晕染进底色 */
.invite-photo-wrap {
  position: relative;
  width: 100%;
  height: 780rpx;
  margin: 0;
  overflow: hidden;
}

.invite-photo {
  width: 100%;
  height: 100%;
}

.invite-photo-fade {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(248, 241, 228, 0) 0%,
    rgba(248, 241, 228, 0) 58%,
    rgba(248, 241, 228, 0.6) 84%,
    #F8F1E4 100%
  );
}

.invite-body {
  width: 100%;
  padding: 0 8rpx;
}

/* 中文邀请文案：信笺式排版 —— 称呼顶格，正文首行缩进两字 */
.invitation-text {
  font-size: 30rpx;
  color: #574536;
  line-height: 2.3;
  margin-bottom: 4rpx;
  text-align: left;
  text-indent: 2em;
  letter-spacing: 2rpx;
  font-family: Georgia, 'Songti SC', 'PingFang SC', serif;
}

.invitation-text:first-child {
  text-indent: 0;
}

/* 凑字排版：浅灰色英文段落 */
.invite-filler {
  margin-top: 72rpx;
  text-align: center;
}

.filler-line {
  font-size: 26rpx;
  color: #B8AE9C;
  font-style: italic;
  font-family: Georgia, serif;
  line-height: 2.1;
  letter-spacing: 1rpx;
}

/* ========== 婚礼信息 ========== */
.info-sheet { align-items: stretch; }

.info-stack {
  width: 100%;
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.info-block {
  border-left: 2rpx solid #C4A06A;
  padding: 10rpx 0 10rpx 28rpx;
}

.shift-right {
  align-self: flex-end;
  border-left: none;
  border-right: 2rpx solid #C4A06A;
  padding: 10rpx 28rpx 10rpx 0;
  text-align: right;
  width: 78%;
}

.info-label {
  font-family: Georgia, serif;
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: #A67C52;
  text-transform: uppercase;
  font-style: italic;
  margin-bottom: 10rpx;
}

.info-big {
  font-family: Georgia, serif;
  font-size: 48rpx;
  color: #5C4030;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.time-big {
  font-size: 72rpx;
  letter-spacing: 2rpx;
  color: #8B5E3C;
}

.info-venue {
  font-family: Georgia, serif;
  font-size: 40rpx;
  color: #5C4030;
  margin-bottom: 8rpx;
}

.info-sub {
  font-size: 24rpx;
  color: #9A8068;
  letter-spacing: 1rpx;
}

/* ========== 甜蜜相册 ========== */
.photo-masonry {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 44rpx;
  padding: 8rpx 4rpx 24rpx;
}

.photo-frame {
  width: 86%;
  background: #fff;
  padding: 16rpx 16rpx 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(70, 45, 20, 0.14);
}

.tilt-left { align-self: flex-start; }
.tilt-right { align-self: flex-end; }

.reveal .tilt-left.enter-left {
  animation: slideInLeftTilt 1.3s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}
.reveal .tilt-right.enter-right {
  animation: slideInRightTilt 1.3s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}

@keyframes slideInLeftTilt {
  from { opacity: 0; transform: translateX(-80rpx) rotate(-1.5deg); }
  to { opacity: 1; transform: translateX(0) rotate(-1.5deg); }
}

@keyframes slideInRightTilt {
  from { opacity: 0; transform: translateX(80rpx) rotate(1.8deg); }
  to { opacity: 1; transform: translateX(0) rotate(1.8deg); }
}

.photo-img {
  width: 100%;
  height: 360rpx;
  display: block;
  filter: sepia(12%);
}

.photo-meta {
  margin-top: 18rpx;
  padding: 0 8rpx;
}

.photo-title {
  display: block;
  font-family: Georgia, serif;
  font-size: 30rpx;
  color: #5C4030;
  font-style: italic;
}

.photo-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9A8068;
}

/* ========== 我们的故事 ========== */
.story-list {
  width: 100%;
  padding: 8rpx 4rpx 24rpx;
}

.story-chapter-block {
  margin-bottom: 56rpx;
  padding: 8rpx 12rpx;
}

.story-chapter-block:nth-child(even) {
  text-align: right;
}

.story-num {
  font-family: Georgia, serif;
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: #A67C52;
  font-style: italic;
  margin-bottom: 8rpx;
}

.story-title {
  font-family: Georgia, serif;
  font-size: 52rpx;
  color: #5C4030;
  margin-bottom: 16rpx;
  font-weight: 400;
}

.story-rule {
  width: 80rpx;
  height: 1rpx;
  background: #C4A06A;
  margin-bottom: 20rpx;
}

.story-chapter-block:nth-child(even) .story-rule {
  margin-left: auto;
}

.story-content {
  font-size: 28rpx;
  color: #6B5344;
  line-height: 2;
  font-family: Georgia, 'Songti SC', serif;
}

/* ========== 地点导航 ========== */
.map-sheet { align-items: stretch; }

.map-venue {
  margin: 20rpx 0 40rpx;
  text-align: center;
}

.venue-name {
  font-family: Georgia, serif;
  font-size: 40rpx;
  color: #5C4030;
  margin-bottom: 6rpx;
}

.venue-hall {
  font-size: 26rpx;
  color: #A67C52;
  font-style: italic;
  margin-bottom: 10rpx;
}

.venue-address {
  font-size: 22rpx;
  color: #9A8068;
  line-height: 1.5;
}

.venue-map {
  width: 100%;
  height: 320rpx;
  margin-bottom: 28rpx;
  border: 8rpx solid #F7ECDD;
  box-shadow: 0 8rpx 24rpx rgba(70, 45, 20, 0.12);
  box-sizing: border-box;
}

.nav-btn {
  width: 70%;
  align-self: center;
  background: transparent;
  color: #5C4030;
  border: 1rpx solid #C4A06A !important;
  border-radius: 0;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  font-family: Georgia, serif;
  padding: 18rpx 0;
  margin-bottom: 32rpx;
}

.nav-btn::after { border: none; }

.tip-list { width: 100%; }

.tip-item {
  font-size: 22rpx;
  color: #8B7355;
  margin-bottom: 10rpx;
  padding-left: 12rpx;
  border-left: 2rpx solid rgba(196, 160, 106, 0.5);
  line-height: 1.5;
}

/* ========== 婚礼流程（Wedding time · 左条目/竖线/右时间 分栏式） ========== */
.timeline-sheet { align-items: stretch; }

.tl-head {
  text-align: center;
  margin-bottom: 52rpx;
}

.tl-script {
  font-family: 'GreatVibes', 'Snell Roundhand', 'Brush Script MT', cursive;
  font-size: 88rpx;
  line-height: 1.25;
  color: #A23B32;
  letter-spacing: 0;
  text-align: center;
}

.tl-date {
  margin-top: 6rpx;
  font-family: Georgia, 'Songti SC', serif;
  font-size: 36rpx;
  font-weight: 600;
  color: #241E17;
  letter-spacing: 4rpx;
}

.tl-lunar {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4A423A;
  letter-spacing: 3rpx;
}

.tl-list {
  width: 100%;
  padding: 4rpx 12rpx 8rpx;
}

.tl-row {
  display: flex;
  align-items: stretch;
}

.tl-left {
  width: 200rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 30rpx;
  font-family: Georgia, serif;
  font-style: italic;
  font-size: 27rpx;
  color: #241E17;
  letter-spacing: 1rpx;
}

.tl-line {
  width: 1rpx;
  flex-shrink: 0;
  background: rgba(36, 30, 23, 0.5);
}

.tl-right {
  flex: 1;
  padding: 24rpx 0 28rpx 32rpx;
}

.tl-time {
  font-family: Georgia, serif;
  font-size: 34rpx;
  font-weight: 600;
  color: #241E17;
  letter-spacing: 2rpx;
}

.tl-title {
  margin-top: 4rpx;
  font-family: Georgia, 'Songti SC', serif;
  font-size: 28rpx;
  color: #3A322A;
  letter-spacing: 2rpx;
}

.tl-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9A8068;
  line-height: 1.5;
}

/* ========== 祝福留言 ========== */
.rsvp-form {
  border: 1rpx solid rgba(196, 160, 106, 0.45);
  padding: 36rpx 28rpx;
  margin-bottom: 36rpx;
  background: rgba(255, 252, 247, 0.55);
}

.form-item { margin-bottom: 20rpx; }

.form-input {
  width: 100%;
  height: 76rpx;
  background: transparent;
  border-bottom: 1rpx solid rgba(196, 160, 106, 0.45);
  padding: 0 8rpx;
  font-size: 26rpx;
  color: #5C4030;
  box-sizing: border-box;
  font-family: Georgia, serif;
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  background: transparent;
  border: 1rpx solid rgba(196, 160, 106, 0.35);
  padding: 16rpx;
  font-size: 26rpx;
  color: #5C4030;
  box-sizing: border-box;
  font-family: Georgia, serif;
}

.submit-btn {
  background: #5C4030;
  color: #F7ECDD;
  border-radius: 0;
  font-size: 26rpx;
  letter-spacing: 8rpx;
  font-family: Georgia, serif;
  padding: 20rpx 0;
  margin-top: 8rpx;
}

.submit-btn::after { border: none; }

.persist-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 20rpx;
  color: #A09080;
}

.wall-title {
  font-family: Georgia, serif;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: #A67C52;
  font-style: italic;
  margin-bottom: 20rpx;
  text-align: center;
}

.blessing-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(196, 160, 106, 0.25);
}

.blessing-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.blessing-name {
  font-family: Georgia, serif;
  font-size: 28rpx;
  color: #5C4030;
  font-style: italic;
}

.blessing-time {
  font-size: 20rpx;
  color: #A09080;
}

.blessing-content {
  font-size: 24rpx;
  color: #6B5344;
  line-height: 1.65;
}

/* 落款 */
.footer-mini {
  text-align: center;
  padding: 72rpx 0 56rpx;
  margin-top: 24rpx;
}

.footer-rule {
  width: 96rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #C4A06A, transparent);
  margin: 0 auto 36rpx;
}

.footer-closing {
  font-size: 26rpx;
  color: #8B7355;
  letter-spacing: 3rpx;
  line-height: 1.8;
  margin-bottom: 40rpx;
  font-family: Georgia, 'Songti SC', serif;
}

.footer-names {
  font-family: Georgia, serif;
  font-size: 36rpx;
  color: #5C4030;
  font-style: italic;
  margin-bottom: 8rpx;
}

