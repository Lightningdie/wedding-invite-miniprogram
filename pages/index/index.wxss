/* 内嵌英文书法字体（Great Vibes）：base64 离线可用 */
@font-face {
  font-family: 'GreatVibes';
  src: url(data:font/woff2;base64,) format('woff2');
  font-weight: 400;
  font-style: normal;
}

/* 内嵌英文手写字体（Alex Brush）：比 Great Vibes 简洁圆润，用于首页标题 */
@font-face {
  font-family: 'AlexBrush';
  src: url(data:font/woff2;base64,) format('woff2');
  font-weight: 400;
  font-style: normal;
}

/* 欧式复古请柬 · 整页竖向翻页 · 隐藏滚动条 */

::-webkit-scrollbar {
  width: 0 !important;
  height: 0 !important;
  display: none !important;
  background: transparent !important;
}

.hide-scrollbar,
.photo-masonry {
  scrollbar-width: none;
}

.invite {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  /* 整页一整条连续渐变 + 多层柔光：白偏黄基调，既有层次又无接缝色差 */
  background:
    radial-gradient(circle at 20% 8%, rgba(255, 253, 248, 0.55), transparent 36%),
    radial-gradient(circle at 82% 46%, rgba(214, 190, 150, 0.12), transparent 42%),
    radial-gradient(circle at 26% 82%, rgba(255, 253, 248, 0.4), transparent 40%),
    linear-gradient(176deg, #FBF7EE 0%, #F9F3E6 16%, #F7F0E1 55%, #F4EBDA 100%);
  position: relative;
}

/* ========== 区块通用 ========== */
.sec {
  width: 100%;
  box-sizing: border-box;
  padding: 128rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  position: relative;
}

/* 区块衔接：顶部细金线 + 居中小纹样，把各区块串成一整页 */
.sec:not(.hero-sheet)::before {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 320rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(196, 160, 106, 0.7), transparent);
  z-index: 1;
}

.sec:not(.hero-sheet)::after {
  content: '✦';
  position: absolute;
  top: 5rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  color: rgba(196, 160, 106, 0.9);
  line-height: 1;
  z-index: 2;
}

.parchment {
  /* 透明，承接整页连续渐变，保证区块衔接零色差 */
  background: transparent;
}

/* 入场动画：滚入视口时由 .reveal 触发 */
.enter { opacity: 0; }

.reveal .enter-left {
  animation: slideInLeft 1.3s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}
.reveal .enter-right {
  animation: slideInRight 1.3s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}
.reveal .enter-up {
  animation: slideInUp 1.3s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}
.reveal .enter-down {
  animation: slideInDown 1.3s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}

.d1 { animation-delay: 0.05s !important; }
.d2 { animation-delay: 0.18s !important; }
.d3 { animation-delay: 0.31s !important; }
.d4 { animation-delay: 0.44s !important; }
.d5 { animation-delay: 0.57s !important; }
.d6 { animation-delay: 0.70s !important; }
.d7 { animation-delay: 0.83s !important; }
.d8 { animation-delay: 0.96s !important; }
.d9 { animation-delay: 1.09s !important; }
.d10 { animation-delay: 1.22s !important; }

@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-80rpx); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes slideInRight {
  from { opacity: 0; transform: translateX(80rpx); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes slideInUp {
  from { opacity: 0; transform: translateY(70rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes slideInDown {
  from { opacity: 0; transform: translateY(-70rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 装饰 */
.latin-tag {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 22rpx;
  letter-spacing: 10rpx;
  text-transform: uppercase;
  color: #A67C52;
  align-self: center;
  margin-bottom: 14rpx;
  font-style: italic;
}

.section-title {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 56rpx;
  color: #5C4030;
  letter-spacing: 8rpx;
  font-weight: 400;
  margin-bottom: 8rpx;
  align-self: center;
  text-align: center;
}

.ornament {
  font-size: 40rpx;
  color: #C4A06A;
  margin: 12rpx 0 32rpx;
  align-self: center;
  opacity: 0.9;
  text-shadow: 0 0 18rpx rgba(196, 160, 106, 0.3);
}

/* 控件：去掉白底圆盘，只留音符本体 */
.music-btn {
  position: fixed;
  /* 刘海屏适配：状态栏高度 + 原间距，避免顶进状态栏 */
  top: calc(36rpx + constant(safe-area-inset-top));
  top: calc(36rpx + env(safe-area-inset-top));
  right: 28rpx;
  z-index: 110;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.music-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 关闭状态：音符上加一道斜线 */
.music-slash {
  position: absolute;
  width: 48rpx;
  height: 2rpx;
  background: #8A7355;
  border-radius: 2rpx;
  transform: rotate(-45deg);
}

/* 播放中：柔和金色脉冲光环 */
.music-on {
  animation: musicPulse 2.2s ease-out infinite;
}

@keyframes musicPulse {
  0% { box-shadow: 0 0 0 0 rgba(196, 160, 106, 0.4); }
  70% { box-shadow: 0 0 0 16rpx rgba(196, 160, 106, 0); }
  100% { box-shadow: 0 0 0 0 rgba(196, 160, 106, 0); }
}

/* ========== 封面 ========== */
.hero-sheet {
  padding: 0;
  height: 100%;
  align-items: center;
  overflow: hidden;
  background: #FAF5EB;
}

.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* 顶部轻微压暗，保证白色花体字可读 */
.hero-topshade {
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(
    180deg,
    rgba(58, 44, 28, 0.24) 0%,
    rgba(58, 44, 28, 0.08) 26%,
    rgba(58, 44, 28, 0) 44%
  );
}

/* 底部掉色晕染：只晕染底部 1/4，照片大面积保留原貌 */
.hero-bottomfade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 25vh;
  z-index: 2;
  background: linear-gradient(
    180deg,
    rgba(250, 245, 235, 0) 0%,
    rgba(250, 245, 235, 0.42) 48%,
    rgba(250, 245, 235, 0.86) 80%,
    #FAF5EB 100%
  );
}

.hero-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 30rpx;
  padding-top: 24vh;
  text-align: center;
}

/* 手写体 We got married（白色，Alex Brush —— 简洁版花体） */
.hero-script {
  font-family: 'AlexBrush', 'Snell Roundhand', 'Brush Script MT', cursive;
  font-size: 100rpx;
  line-height: 1.35;
  color: #FFFFFF;
  letter-spacing: 0;
  text-shadow: 0 2rpx 22rpx rgba(70, 50, 30, 0.42), 0 0 2rpx rgba(70, 50, 30, 0.3);
}

/* 倒计时：位于花体下方，无边框、紧凑一行，与花体同风格 */
.countdown-card {
  margin-top: 24rpx;
  text-align: center;
}

.countdown-caption {
  font-family: Georgia, 'Songti SC', serif;
  font-size: 20rpx;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
  color: rgba(255, 252, 244, 0.88);
  margin-bottom: 2rpx;
  text-shadow: 0 1rpx 12rpx rgba(70, 50, 30, 0.55);
}

.countdown-row {
  display: flex;
  justify-content: center;
  align-items: baseline;
  line-height: 1;
}

.countdown-cell {
  display: flex;
  align-items: baseline;
  margin: 0 11rpx;
}

.countdown-num {
  font-family: 'AlexBrush', 'Snell Roundhand', 'Brush Script MT', cursive;
  font-size: 52rpx;
  line-height: 1.2;
  color: #FFFDF6;
  text-shadow: 0 2rpx 16rpx rgba(70, 50, 30, 0.5), 0 0 2rpx rgba(70, 50, 30, 0.35);
}

.countdown-label {
  margin-left: 6rpx;
  font-family: Georgia, 'Songti SC', serif;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 252, 244, 0.82);
  text-shadow: 0 1rpx 12rpx rgba(70, 50, 30, 0.55);
}

/* 当天文案 */
.countdown-today {
  font-family: 'Kaiti SC', 'STKaiti', 'KaiTi', '楷体', Georgia, serif;
  font-size: 32rpx;
  letter-spacing: 6rpx;
  color: #FFFDF6;
  line-height: 1.4;
  text-shadow: 0 2rpx 16rpx rgba(70, 50, 30, 0.5), 0 0 2rpx rgba(70, 50, 30, 0.35);
}

/* 姓名与日期：叠在底部晕染之上，黑色字 */
.hero-landing {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 132rpx;
  z-index: 3;
  text-align: center;
  padding: 0 40rpx;
}

.hero-names {
  font-family: 'Kaiti SC', 'STKaiti', 'KaiTi', '楷体', 'DFKai-SB', Georgia, serif;
  font-size: 56rpx;
  font-weight: 400;
  color: #241E17;
  letter-spacing: 6rpx;
  line-height: 1.3;
  /* 晕染只剩底部 1/4，名字大部分压在照片上，加一层浅色投影保可读 */
  text-shadow: 0 1rpx 14rpx rgba(250, 245, 235, 0.65);
}

.hero-amp {
  font-family: Georgia, serif;
  font-style: italic;
  font-size: 42rpx;
  color: #7A654E;
}

.hero-date {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #3A322A;
  letter-spacing: 4rpx;
}

.scroll-hint {
  position: absolute;
  bottom: 52rpx;
  left: 0;
  right: 0;
  z-index: 3;
  text-align: center;
  color: rgba(90, 74, 55, 0.7);
  font-size: 20rpx;
  letter-spacing: 4rpx;
  font-family: Georgia, serif;
  animation: floatHint 2.4s ease-in-out infinite;
}

@keyframes floatHint {
  0%, 100% { transform: translateY(0); opacity: 0.55; }
  50% { transform: translateY(10rpx); opacity: 0.9; }
}

/* ========== 邀请（第二页） ========== */
.invitation-sheet {
  align-items: stretch;
}

/* 顶部是花体标题，去掉区块衔接的金线与小纹样 */
.invitation-sheet::before,
.invitation-sheet::after {
  content: none;
}

/* 第一行：英文标题（Alex Brush 简洁手写体，缩到一行内） */
.invite-headline {
  margin: 0 0 36rpx;
  align-self: center;
  text-align: center;
  white-space: nowrap;
  font-family: 'AlexBrush', 'Snell Roundhand', 'Brush Script MT', cursive;
  font-size: 44rpx;
  line-height: 1.4;
  color: #4A3A2C;
  letter-spacing: 0;
}

/* 窄屏：花体标题降字号，避免单行溢出被裁切 */
@media (max-width: 360px) {
  .invite-headline { font-size: 36rpx; }
}
@media (max-width: 320px) {
  .invite-headline { font-size: 32rpx; }
}

/* 第二行：整幅出血照片，底部晕染进底色（按屏高取值，保证整页放得下） */
.invite-photo-wrap {
  position: relative;
  width: 100%;
  height: 36vh;
  min-height: 300rpx;
  margin: 0;
  overflow: hidden;
}

.invite-photo {
  width: 100%;
  height: 100%;
}

.invite-photo-fade {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(248, 241, 228, 0) 0%,
    rgba(248, 241, 228, 0) 58%,
    rgba(248, 241, 228, 0.6) 84%,
    #F8F1E4 100%
  );
}

.invite-body {
  width: 100%;
  padding: 16rpx 8rpx;
}

/* 中文邀请文案：整段居中 */
.invitation-text {
  font-size: 30rpx;
  color: #574536;
  line-height: 2.3;
  margin-bottom: 4rpx;
  text-align: center;
  letter-spacing: 2rpx;
  font-family: Georgia, 'Songti SC', 'PingFang SC', serif;
}

/* 凑字排版：浅灰色英文段落 */
.invite-filler {
  margin-top: 36rpx;
  text-align: center;
}

.filler-line {
  font-size: 26rpx;
  color: #B8AE9C;
  font-style: italic;
  font-family: Georgia, serif;
  line-height: 2.1;
  letter-spacing: 1rpx;
}

/* ========== 甜蜜相册 ========== */
.photo-masonry {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 44rpx;
  padding: 8rpx 4rpx 24rpx;
}

.photo-frame {
  width: 86%;
  background: #fff;
  padding: 16rpx 16rpx 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(70, 45, 20, 0.14);
}

.tilt-left { align-self: flex-start; }
.tilt-right { align-self: flex-end; }

.reveal .tilt-left.enter-left {
  animation: slideInLeftTilt 1.3s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}
.reveal .tilt-right.enter-right {
  animation: slideInRightTilt 1.3s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}

@keyframes slideInLeftTilt {
  from { opacity: 0; transform: translateX(-80rpx) rotate(-1.5deg); }
  to { opacity: 1; transform: translateX(0) rotate(-1.5deg); }
}

@keyframes slideInRightTilt {
  from { opacity: 0; transform: translateX(80rpx) rotate(1.8deg); }
  to { opacity: 1; transform: translateX(0) rotate(1.8deg); }
}

.photo-img {
  width: 100%;
  height: 360rpx;
  display: block;
  filter: sepia(12%);
}

.photo-meta {
  margin-top: 18rpx;
  padding: 0 8rpx;
}

.photo-title {
  display: block;
  font-family: Georgia, serif;
  font-size: 30rpx;
  color: #5C4030;
  font-style: italic;
}

.photo-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9A8068;
}

/* ========== 婚礼流程 + 婚礼地点（同页 · 左条目/竖线/右时间 分栏式） ========== */
.timeline-sheet { align-items: stretch; }

.tl-head {
  text-align: center;
  margin-bottom: 18rpx;
}

.tl-script {
  font-family: 'GreatVibes', 'Snell Roundhand', 'Brush Script MT', cursive;
  font-size: 54rpx;
  line-height: 1.25;
  color: #A23B32;
  letter-spacing: 0;
  text-align: center;
}

.tl-date {
  margin-top: 2rpx;
  font-family: Georgia, 'Songti SC', serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #241E17;
  letter-spacing: 4rpx;
}

.tl-lunar {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #4A423A;
  letter-spacing: 3rpx;
}

.tl-list {
  width: 100%;
  padding: 4rpx 12rpx 8rpx;
}

.tl-row {
  display: flex;
  align-items: stretch;
}

/* 左栏：小图标 + 英文名（图标高度约为文字一半，仿参考图） */
.tl-left {
  width: 224rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 26rpx;
  white-space: nowrap;
}

.tl-ic {
  width: 34rpx;
  height: 30rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.tl-en {
  font-family: Georgia, serif;
  font-style: italic;
  font-size: 23rpx;
  color: #241E17;
  letter-spacing: 1rpx;
}

.tl-line {
  width: 1rpx;
  flex-shrink: 0;
  background: rgba(36, 30, 23, 0.5);
}

.tl-right {
  flex: 1;
  padding: 8rpx 0 8rpx 26rpx;
}

.tl-time {
  font-family: Georgia, serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #241E17;
  letter-spacing: 2rpx;
}

.tl-title {
  margin-top: 2rpx;
  font-family: Georgia, 'Songti SC', serif;
  font-size: 25rpx;
  color: #3A322A;
  letter-spacing: 2rpx;
}

.tl-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9A8068;
  line-height: 1.5;
}

/* 婚礼地点：并入流程页，仅保留文字信息 */
.tl-address {
  margin-top: 24rpx;
  text-align: center;
}

.tl-venue {
  margin-top: 10rpx;
  font-family: Georgia, 'Songti SC', serif;
  font-size: 30rpx;
  color: #241E17;
  letter-spacing: 3rpx;
}

.tl-hall {
  margin-top: 4rpx;
  font-size: 25rpx;
  color: #A67C52;
  font-style: italic;
  letter-spacing: 2rpx;
}

.tl-addr {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9A8068;
  letter-spacing: 1rpx;
  line-height: 1.5;
}

/* ========== 祝福留言 ========== */
.rsvp-form {
  border: 1rpx solid rgba(196, 160, 106, 0.45);
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 252, 247, 0.55);
}

.form-item { margin-bottom: 16rpx; }

.form-input {
  width: 100%;
  height: 76rpx;
  background: transparent;
  border-bottom: 1rpx solid rgba(196, 160, 106, 0.45);
  padding: 0 8rpx;
  font-size: 26rpx;
  color: #5C4030;
  box-sizing: border-box;
  font-family: Georgia, serif;
}

.form-textarea {
  width: 100%;
  height: 110rpx;
  background: transparent;
  border: 1rpx solid rgba(196, 160, 106, 0.35);
  padding: 16rpx;
  font-size: 26rpx;
  color: #5C4030;
  box-sizing: border-box;
  font-family: Georgia, serif;
}

.submit-btn {
  background: #5C4030;
  color: #F7ECDD;
  border-radius: 0;
  font-size: 26rpx;
  letter-spacing: 8rpx;
  font-family: Georgia, serif;
  padding: 20rpx 0;
  margin-top: 8rpx;
}

.submit-btn::after { border: none; }

.persist-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 20rpx;
  color: #A09080;
}

.wall-title {
  font-family: Georgia, serif;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: #A67C52;
  font-style: italic;
  margin-bottom: 12rpx;
  text-align: center;
}

.blessing-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(196, 160, 106, 0.25);
}

.blessing-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.blessing-name {
  font-family: Georgia, serif;
  font-size: 28rpx;
  color: #5C4030;
  font-style: italic;
}

.blessing-time {
  font-size: 20rpx;
  color: #A09080;
}

.blessing-content {
  font-size: 24rpx;
  color: #6B5344;
  line-height: 1.65;
}

/* 云端读取中：骨架占位 */
.blessing-skeleton {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(196, 160, 106, 0.25);
}

.skeleton-line {
  height: 22rpx;
  border-radius: 3rpx;
  background: rgba(196, 160, 106, 0.16);
  margin: 10rpx 0;
  animation: skeletonBreathe 1.4s ease-in-out infinite;
}

.skeleton-line.skeleton-name {
  width: 32%;
  height: 26rpx;
}

@keyframes skeletonBreathe {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 1; }
}

/* 空态：引导留言 */
.blessing-empty {
  padding: 28rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #A09080;
  letter-spacing: 2rpx;
}

/* 刚送出的祝福：滑入强调 */
.blessing-new {
  animation: slideInDown 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
}

/* 落款 */
.footer-mini {
  text-align: center;
  padding: 24rpx 0 0;
  margin-top: 16rpx;
}

.footer-rule {
  width: 96rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #C4A06A, transparent);
  margin: 0 auto 20rpx;
}

.footer-closing {
  font-size: 26rpx;
  color: #8B7355;
  letter-spacing: 3rpx;
  line-height: 1.8;
  margin-bottom: 16rpx;
  font-family: Georgia, 'Songti SC', serif;
}

.footer-names {
  font-family: 'Kaiti SC', 'STKaiti', 'KaiTi', '楷体', 'DFKai-SB', Georgia, serif;
  font-size: 36rpx;
  color: #5C4030;
  margin-bottom: 8rpx;
}

.footer-date {
  font-size: 22rpx;
  color: #A67C52;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.footer-text {
  font-family: Georgia, serif;
  font-size: 22rpx;
  color: #9A8068;
  letter-spacing: 4rpx;
  font-style: italic;
}

/* ========== 分享 ========== */
/* 引导小字：转发与朋友圈分享均从右上角菜单进入 */
.share-tip {
  text-align: center;
  font-size: 20rpx;
  color: #A09080;
  letter-spacing: 2rpx;
}

/* ========== 整页翻页（swiper）布局：每页占满一屏 ========== */
.page-swiper {
  width: 100%;
  height: 100vh;
}

/* swiper-item 内的区块铺满整屏，水平留白沿用原间距 */
.page-swiper .sec {
  height: 100%;
  padding: 0 48rpx;
}

.page-swiper .hero-sheet {
  padding: 0;
}

.page-swiper .photos-sheet {
  padding: 84rpx 48rpx 24rpx;
}

.page-swiper .timeline-sheet {
  padding: 52rpx 44rpx 32rpx;
}

.page-swiper .rsvp-sheet {
  padding: 60rpx 48rpx 36rpx;
  /* 末页元素垂直均匀分布，不顶格 */
  justify-content: space-evenly;
}

/* 页内固定内容不压缩，剩余空间让给滚动区 */
.page-swiper .sec > view {
  flex-shrink: 0;
}

.page-swiper .sec > .inner-scroll,
.page-swiper .sec > .blessing-wall {
  flex-shrink: 1;
}

/* 页内滚动区：相册整页滚，邀请/流程兜底滚，祝福墙定高滚 */
.inner-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

/* 祝福墙按内容自适应高度，超出上限内部滚动，把剩余空间留给均匀间距 */
.blessing-wall {
  flex: 0 1 auto;
  max-height: 40vh;
  display: flex;
  flex-direction: column;
}

.blessing-wall-scroll {
  min-height: 160rpx;
}

/* 滚动区内容不满一屏时垂直居中，满屏则自然排列 */
.page-body {
  min-height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.pb-invitation {
  padding: 28rpx 0;
}

.pb-timeline {
  padding: 20rpx 0;
}

/* 右侧页码指示点：点击直达对应页 */
.page-dots {
  position: fixed;
  right: 14rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 60;
}

.page-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(122, 101, 78, 0.32);
  margin: 9rpx 0;
  box-shadow: 0 1rpx 4rpx rgba(70, 50, 30, 0.16);
  transition: height 0.25s ease, background 0.25s ease;
}

.page-dot.active {
  height: 30rpx;
  border-radius: 6rpx;
  background: #C4A06A;
}

/* ========== 短屏适配：压缩字号与间距，保证每页完整显示 ========== */
@media (max-height: 640px) {
  .hero-script { font-size: 84rpx; }
  .hero-content { padding-top: 19vh; }
  .countdown-num { font-size: 44rpx; }
  .hero-names { font-size: 48rpx; }
  .hero-landing { bottom: 112rpx; }
  .section-title { font-size: 46rpx; }
  .ornament { margin: 8rpx 0 22rpx; }
  .tl-script { font-size: 46rpx; }
  .tl-desc { display: none; }
  .invitation-text { font-size: 27rpx; line-height: 2; }
  .invite-filler { margin-top: 28rpx; }
  .form-textarea { height: 100rpx; }
  .footer-mini { padding-top: 14rpx; }
  .blessing-wall-scroll { min-height: 120rpx; }
}

@media (max-height: 580px) {
  .invite-photo-wrap { height: 28vh; min-height: 240rpx; }
  .invite-filler { display: none; }
  .tl-address { margin-top: 18rpx; }
  .hero-date { margin-top: 10rpx; }
}
