.guests-page {
  min-height: 100vh;
  padding: 24rpx 30rpx 120rpx;
  box-sizing: border-box;
  background: #FFF8F0;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.summary {
  font-size: 24rpx;
  color: #8B7355;
}

.toolbar-actions {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.add-btn {
  background: #D4AF37 !important;
  color: #fff !important;
  border-radius: 30rpx;
}

.clear-btn {
  background: #C07070 !important;
  color: #fff !important;
  border-radius: 30rpx;
}

.empty {
  text-align: center;
  color: #B8A89A;
  padding: 120rpx 0;
  font-size: 26rpx;
}

.guest-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(139, 115, 85, 0.05);
}

.guest-main {
  flex: 1;
  padding-right: 20rpx;
}

.guest-name {
  font-size: 30rpx;
  color: #8B7355;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.guest-meta {
  font-size: 22rpx;
  color: #B8A89A;
}

.guest-msg {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6B5B4F;
  line-height: 1.5;
}

.guest-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  justify-content: center;
}

.action {
  font-size: 24rpx;
  color: #C4A030;
}

.action.danger {
  color: #C07070;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #FFF8F0;
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 30rpx 60rpx;
}

.sheet-title {
  text-align: center;
  font-size: 32rpx;
  color: #8B7355;
  margin-bottom: 28rpx;
}

.form-group {
  margin-bottom: 20rpx;
}

.label {
  font-size: 24rpx;
  color: #8B7355;
  margin-bottom: 10rpx;
}

.input,
.picker {
  width: 100%;
  height: 76rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #4A4A4A;
  box-sizing: border-box;
  border: 1rpx solid #F0E6D0;
  display: flex;
  align-items: center;
}

.save-btn {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #D4AF37 0%, #C4A030 100%);
  color: #fff;
  border-radius: 50rpx;
}

.save-btn::after {
  border: none;
}
