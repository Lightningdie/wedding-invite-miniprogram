.edit-page {
  min-height: 100vh;
  padding: 30rpx 30rpx 80rpx;
  box-sizing: border-box;
  background: #FFF8F0;
}

.form-group {
  margin-bottom: 24rpx;
}

.label {
  font-size: 24rpx;
  color: #8B7355;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #4A4A4A;
  box-sizing: border-box;
  border: 1rpx solid #F0E6D0;
}

.hint {
  font-size: 22rpx;
  color: #B8A89A;
  margin-top: 10rpx;
}

.save-btn {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #D4AF37 0%, #C4A030 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
}

.save-btn::after {
  border: none;
}

.reset-btn {
  margin-top: 20rpx;
  background: #fff;
  color: #B8A89A;
  border-radius: 50rpx;
  font-size: 26rpx;
  border: 1rpx solid #E8DCC8;
}

.reset-btn::after {
  border: none;
}
